# 발표/데모용 접근 코드 게이트에서 쓰는 값. 로컬 개발 시 이 파일을 .env로
# 복사해서 원하는 값으로 바꿔서 쓰면 됨. 설정하지 않으면 게이트가 자동으로
# 비활성화됨(로컬 개발 편의를 위함).
VITE_ACCESS_CODE=changeme

# 백엔드/AI 서버 주소. 로컬 개발 시에는 비워두면 Vite 프록시(/api → :8080, /ai → :8000)를 사용.
# 배포(Vercel)에서는 프로젝트 환경 변수로 아래 값을 설정.
VITE_API_BASE=
# VITE_API_BASE=https://api.kickdan.com
VITE_AI_BASE=
# VITE_AI_BASE=https://ai.kickdan.com

# 데모 모드: true면 서버 없이 예시 데이터로 화면을 보여줌(발표 백업용).
# 비워두고 주소에 ?demo=1 을 붙여서 켜도 됨(?demo=0 으로 끄기).
VITE_DEMO_MODE=
